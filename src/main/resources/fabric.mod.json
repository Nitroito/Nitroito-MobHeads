{
  "schemaVersion": 1,
  "id": "nitroito_mobheads",
  "version": "${version}",
  "name": "${name}",
  "description": "Adds mob heads to the game with advancements to track the progression",
  "authors": ["${author}"],
  "icon": "assets/nitroito_mobheads/icon.png",
  "contact": {
      "homepage": "https://modrinth.com/mod/nitroito-mobheads",
      "sources": "https://github.com/Nitroito/Nitroito-MobHeads",
      "issues": "https://github.com/Nitroito/Nitroito-MobHeads/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "pt.nitroito.mobheads.MobHeads"
    ],
    "client": [
      "pt.nitroito.mobheads.MobHeadsClient"
    ],
    "modmenu": [
      "pt.nitroito.mobheads.config.ModMenuIntegration"
    ]
  },
  "fabric-datagen": [
    "pt.nitroito.mobheads.MobHeadsMainDataGenerator",
    "pt.nitroito.mobheads.MobHeadsClientDataGenerator"
  ],
  "accessWidener": "nitroito_mobheads.classtweaker",
  "mixins": [
    "nitroito_mobheads.mixins.json",
    {
      "config": "nitroito_mobheads.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "minecraft": ">=${minecraft_version}",
    "fabricloader": ">=${loader_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
